library(tidyr)
library(ggplot2)
library(ggpubr)
library(lme4)
library(lmerTest)
# reading data frame
data_frame <- read.csv("data/data_preprocessed/data.csv")
# removing rows we are not interested in
df_clean <- subset(data_frame, original_sentence != "")
# removing practice trials
df_clean <- subset(df_clean, !is.na(correct_change_answer))
demographics <- df_clean %>%
group_by(participant) %>%
summarise(language = first(language),
age = first(age),
education = first(education))
demographics
# excluding one participant who answered Danish as first language
# -------------------------------------------------------------
participant_to_exclude1 <- c("l4kkhlaf")
df_clean <- subset(df_clean, !participant %in% participant_to_exclude1)
data_frame <- subset(data_frame, !participant %in% participant_to_exclude1)
# making a "correct/incorrect"-column
df_clean$correct_incorrect <- ifelse(
df_clean$Ychange_Nchange_response == "no" & df_clean$correct_change_answer == "no_change" |
df_clean$Ychange_Nchange_response == "yes" & df_clean$correct_change_answer == "affix_deletion" & df_clean$response == df_clean$correct_response |
df_clean$Ychange_Nchange_response == "yes" & df_clean$correct_change_answer == "other_change" & df_clean$response == df_clean$correct_response |
df_clean$Ychange_Nchange_response == "yes" & df_clean$correct_change_answer == "subject_deletion"& df_clean$response == df_clean$correct_response,
1, 0)
# how many correct does each participant have?
df_correct_count <- df_clean %>%
group_by(participant) %>%
summarize(correct_count = sum(correct_incorrect))
View(df_correct_count)
# excluding participants that have less than 43 correct
participants_to_exclude2 <- subset(df_correct_count$participant, df_correct_count$correct_count < 43)
participants_to_exclude2
# excluding participants that have less than 43 correct
participants_to_exclude2 <- subset(df_correct_count$participant, df_correct_count$correct_count < 53)
participants_to_exclude2
df_clean <- subset(df_clean, !participant %in% participants_to_exclude2)
data_frame <- subset(data_frame, !participant %in% participants_to_exclude2)
# checking how long they spent on the change detection part of the experiment
df_time_change_detection <- df_clean %>%
group_by(participant) %>%
summarise(total_time = max(time_elapsed, na.rm = TRUE)/60000)
df_time_change_detection
# excluding outliers whose total time spent on the change detection part was more than 3 SDs from the mean
mean_time <- mean(df_time_change_detection$total_time)
sd_time <- sd(df_time_change_detection$total_time)
cutoff <- mean_time + 3*sd_time
cutoff
participants_above_cutoff <- ("knkl4dbx")
df_clean <- subset(df_clean, !participant %in% participants_above_cutoff)
data_frame <- subset(data_frame, !participant %in% participants_above_cutoff)
reading_time_first_sentence <- data_frame %>%
group_by(participant, sentence_id_specific) %>%
summarise(reading_time_sentence1 = first(rt))
mean_reading_time_first_sentence <- reading_time_first_sentence %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA))) %>%
group_by(participant) %>%
summarise(mean_rt_sentence1 = mean(reading_time_sentence1))
change_detection_time <- data_frame %>%
group_by(participant, sentence_id_specific) %>%
summarise(change_detection_time = rt[[2]])
mean_change_detection_time <- change_detection_time %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA))) %>%
group_by(participant) %>%
summarise(mean_change_detection_rt = mean(change_detection_time))
localization_time <- data_frame %>%
group_by(participant, sentence_id_specific) %>%
summarise(localization_time = rt[[3]])
mean_localization_time <- localization_time %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA))) %>%
group_by(participant) %>%
summarise(mean_localization_rt = mean(localization_time))
rt_different_stages <- merge(merge(mean_reading_time_first_sentence, mean_change_detection_time), mean_localization_time)
rt_long <- rt_different_stages %>%
pivot_longer(
cols = c(
mean_rt_sentence1,
mean_change_detection_rt,
mean_localization_rt
),
names_to = "stage",
values_to = "rt"
)
rt_plot <- ggplot(rt_long, aes(x = "", y = rt)) +
geom_boxplot() +
facet_wrap(~ factor(stage, c("mean_rt_sentence1", "mean_change_detection_rt", "mean_localization_rt"))) +
ylim(c(0,11000)) +
labs(
x = NULL,
y = "Reaction time (ms)",
title = "Reaction times across stages"
) +
theme_bw()
rt_plot
ggsave("figures/rt_different_stages.png", plot = rt_plot, width = 9, height = 4)
# get reaction times for all trials
rt_different_stages_full <- merge(merge(reading_time_first_sentence, change_detection_time), localization_time) %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA))) %>%
mutate(sum_rt = reading_time_sentence1 + change_detection_time + localization_time)
# calculate participant means and SDs - and merge
rt_mean_and_SD <- rt_different_stages_full %>%
group_by(participant) %>%
summarise(mean_rt = mean(sum_rt),
sd_rt = sd(sum_rt))
rt_different_stages_full_merged <- merge(rt_different_stages_full, rt_mean_and_SD, by = "participant")
# get outlier trials
rt_outliers <- rt_different_stages_full_merged %>%
filter(sum_rt > mean_rt + 3 * sd_rt)
# exclude outliers
df_clean <- df_clean %>%
anti_join(rt_outliers, by = c("participant", "sentence_id_specific"))
df_clean_affix <- subset(df_clean, correct_change_answer == "affix_deletion")
# LOCALIZATION
df_clean_correct <- df_clean_affix %>%
filter(correct_incorrect == 1)
df_clean_correct$localization_correct <- ifelse(
df_clean_correct$response == df_clean_correct$correct_response,
1, 0
)
mean(df_clean_correct$localization_correct)
# bar plot
# --------
# group the data by participant and calculate the mean number of correct responses per participant
# in the two conditions
df_participant_mean <- df_clean_affix %>%
group_by(participant, affix_type) %>%
summarise(mean_accuracy = mean(correct_incorrect),
.groups = "drop")
# make a bar plot with errorbars and jitter points
accuracy_barplot <- ggbarplot(df_participant_mean,
x = "affix_type",
y = "mean_accuracy",
add = c("mean_se", "jitter"),
xlab = FALSE,
ylab = "Mean accuracy",
title = "Change detection of grammatical and lexical affixes") +
ylim(0, 1) +
theme_bw()
accuracy_barplot
ggsave("figures/accuracy_barplot.png", plot = accuracy_barplot, width = 6, height = 4)
# line plot where each line is a participant
# -------------------------------------------
line_plot_accuracy <- df_participant_mean %>%
ggplot(aes(affix_type, mean_accuracy)) +
geom_line(data = df_participant_mean, aes(affix_type, mean_accuracy, group = participant, color = participant), alpha = 0.4) +
# geom_errorbar(aes(ymin = correct_ratio - 0.01, ymax = correct_ratio + 0.01), width = 0.1) +
stat_summary(fun = mean, geom = 'point', aes(group = 1)) +
stat_summary(fun = mean, geom = 'line', aes(group = 1), linewidth = 0.5) +
theme_bw() +
theme(legend.position = 'none', axis.text = element_text(size = 12), axis.title = element_text(size = 15)) +
labs(x = '', y = 'accuracy') +
ylim(0, 1)
line_plot_accuracy
ggsave("figures/line_plot_accuracy.png", plot = line_plot_accuracy, width = 6, height = 4)
model1_affix_type <- glmer(correct_incorrect ~ affix_type + (1|participant),
family = 'binomial',
df_clean_affix)
summary(model1_affix_type)
# read csv containing affix frequencies ad calculate log10 frequency
frequencies <- read.csv("research materials/suffix_frequencies.csv", sep = ";")
frequencies <- frequencies %>%
mutate(log10freq = log10(frequency))
# merge frequency info with affix data frame
df_clean_affix_merged <- merge(df_clean_affix, frequencies, by.x = "target_affix", by.y = "suffix")
# add length column
df_clean_affix_merged <- df_clean_affix_merged %>%
mutate(affix_length = nchar(target_affix))
# model which includes frequency and lengt as predictors
model2_affix_type <- glmer(correct_incorrect ~ affix_type +
log10freq + affix_length + (1|participant),
family = 'binomial',
df_clean_affix_merged)
summary(model2_affix_type)
# bar plot for specific suffixes
# ---------------------------------
# grouping by participant, target affix and affix type and calculating accuracy
df_affixes <- df_clean_affix %>%
group_by(participant, target_affix, affix_type) %>%
summarise(
accuracy = mean(correct_incorrect)
)
# plotting
plot_suffixes <- ggbarplot(df_affixes, x = "target_affix", y = "accuracy",
add = c("mean_se"),
fill = "affix_type",
x.text.angle = 90,  # Rotate x-axis labels vertically
xlab = FALSE,
legend = "right",
title = "accuracy for individual affixes",
sort.val = "asc"
)
plot_suffixes
ggsave("figures/bar_plot_suffixes.png", plot = plot_suffixes, width = 6, height = 4)
# get mean reading times for sentence 1
df_rt_sentence1 <- rt_long %>%
filter(stage == "mean_rt_sentence1")
names(df_rt_sentence1)[names(df_rt_sentence1) == "rt"] <- "mean_rt_sentence1"
# merge with df_clean_affix
df_clean_affix2 <- merge(df_clean_affix, df_rt_sentence1, by = "participant")
# plot mean accuracy
mean_accuracy_and_rt <- df_clean_affix2 %>%
group_by(participant) %>%
summarise(mean_rt_sentence1 = first(mean_rt_sentence1),
mean_accuracy = mean(correct_incorrect))
# (exclude outlier) MAYBE THIS PERSON SHOULD BE EXCLUDED ENTIRELY EARLIER ON
mean_accuracy_and_rt <- mean_accuracy_and_rt %>%
filter(participant != "5kqwq452")
mean_accuracy_by_rt_plot <- ggplot(aes(x = mean_rt_sentence1, y = mean_accuracy),
data = mean_accuracy_and_rt) +
geom_point() +
geom_smooth()
mean_accuracy_by_rt_plot
View(df_time_change_detection)
cutoff <- mean_time + 3*sd_time
cutoff
View(rt_long)
reading_time_first_sentence
rt_per_character <- data_frame %>%
group_by(participant, sentence_id_specific) %>%
summarise(rt_sentence1 = first(rt)) %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA)))
View(rt_per_character)
View(data_frame)
rt_per_character <- data_frame %>%
group_by(participant, sentence_id_specific, original_sentence) %>%
summarise(rt_sentence1 = first(rt)) %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA)))
View(rt_per_character)
rt_per_character <- data_frame %>%
group_by(participant, sentence_id_specific) %>%
summarise(rt_sentence1 = first(rt)) %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA)))
rt_per_character <- reading_time_first_sentence %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA)))
rt_per_character <- reading_time_first_sentence %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA))) %>%
left_join(
df_clean_affix %>% select(sentence_id_specific, original_sentence),
by = "sentence_id_specific"
)
View(rt_per_character)
rt_per_character$original_sentence <- df_clean_affix$original_sentence[
match(rt_per_character$sentence_id_specific, df_clean_affix$sentence_id_specific)
]
rt_per_character <- reading_time_first_sentence %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA)))
rt_per_character$original_sentence <- df_clean_affix$original_sentence[
match(rt_per_character$sentence_id_specific, df_clean_affix$sentence_id_specific)
]
View(rt_per_character)
View(df_clean_affix)
sentence_df <- df_clean %>%
group_by(sentence_id_specific) %>%
summarise(sentence1 = first(original_sentence))
View(sentence_df)
rt_per_character$original_sentence <- sentence_df$sentence1[
match(rt_per_character$sentence_id_specific, sentence_df$sentence_id_specific)
]
View(rt_per_character)
rt_per_character$sentence1 <- sentence_df$sentence1[
match(rt_per_character$sentence_id_specific, sentence_df$sentence_id_specific)
]
sentence_df <- df_clean %>%
group_by(sentence_id_specific) %>%
summarise(sentence1 = first(original_sentence))
rt_per_character <- reading_time_first_sentence %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA)))
rt_per_character$sentence1 <- sentence_df$sentence1[
match(rt_per_character$sentence_id_specific, sentence_df$sentence_id_specific)
]
rt_per_character <- rt_per_character %>%
mutate(rt_per_char = reading_time_sentence1 / nchar(sentence1))
View(rt_per_character)
rt_per_character <- rt_per_character %>%
group_by(participant) %>%
mutate(
rt_per_char_centered = rt_per_char - mean(rt_per_char, na.rm = TRUE),
rt_per_char_z = as.numeric(scale(rt_per_char))
) %>%
ungroup()
View(rt_per_character)
View(df_clean_affix)
# merge with df_clean_affix
df_accuracy_and_rt <- df_clean_affix %>%
left_join(rt_per_character, by = "sentence_id_specific")
# merge with df_clean_affix
df_accuracy_and_rt <- df_clean_affix %>%
left_join(rt_per_character, by = c("sentence_id_specific", "participant"))
View(df_accuracy_and_rt)
accuracy_by_rt_plot <- ggplot(aes(x = rt_per_char_z, y = correct_incorrect),
data = df_accuracy_and_rt) +
geom_point() +
geom_smooth()
accuracy_by_rt_plot
accuracy_by_rt_plot <- ggplot(
df_accuracy_and_rt,
aes(x = rt_per_char_z, y = correct_incorrect)
) +
geom_jitter(
height = 0.05,
width = 0.05,
alpha = 0.15
) +
geom_smooth(
method = "glm",
method.args = list(family = "binomial"),
se = TRUE
) +
labs(
x = "Standardized reading time per character",
y = "Change detection accuracy",
title = "Change detection accuracy as a function of reading time"
) +
theme_classic()
accuracy_by_rt_plot
accuracy_binned <- df_accuracy_and_rt %>%
mutate(rt_bin = ntile(rt_per_char_z, 10)) %>%
group_by(rt_bin) %>%
summarise(
mean_rt = mean(rt_per_char_z, na.rm = TRUE),
accuracy = mean(correct_incorrect, na.rm = TRUE),
n = n(),
se = sqrt(accuracy * (1 - accuracy) / n),
.groups = "drop"
)
ggplot(accuracy_binned, aes(x = mean_rt, y = accuracy)) +
geom_point(size = 3) +
geom_line() +
geom_errorbar(
aes(ymin = accuracy - 1.96 * se,
ymax = accuracy + 1.96 * se),
width = 0.05
) +
labs(
x = "Standardized reading time per character",
y = "Proportion correct",
title = "Change detection accuracy across reading time deciles"
) +
theme_classic()
ggplot(
df_accuracy_and_rt,
aes(x = rt_per_char_z, y = correct_incorrect)
) +
geom_smooth(
method = "glm",
method.args = list(family = "binomial"),
se = FALSE
) +
facet_wrap(~ participant_id) +
labs(
x = "Standardized reading time per character",
y = "Probability of correct change detection"
) +
theme_classic()
ggplot(
df_accuracy_and_rt,
aes(x = rt_per_char_z, y = correct_incorrect)
) +
geom_smooth(
method = "glm",
method.args = list(family = "binomial"),
se = FALSE
) +
facet_wrap(~ participant) +
labs(
x = "Standardized reading time per character",
y = "Probability of correct change detection"
) +
theme_classic()
View(df_clean_affix2)
df_lexical_advantage <- df_clean_affix2 %>%
group_by(participant, mean_rt_sentence1, affix_type) %>%
summarise(mean_accuracy = mean(correct_incorrect))
View(df_lexical_advantage)
df_lexical_advantage_wider <- df_lexical_advantage %>%
select(participant, affix_type, mean_accuracy, mean_rt_sentence1) %>%
pivot_wider(
names_from = affix_type,
values_from = mean_accuracy
) %>%
mutate(
lexical_advantage = lexical - grammatical
)
View(df_lexical_advantage_wider)
lexical_advantage_plot <- ggplot(df_lexical_advantage_wider,
aes(x = mean_rt_sentence1, y = lexical_advantage)) +
geom_hline(yintercept = 0, linetype = "dashed", colour = "grey50") +
geom_point(size = 3) +
geom_smooth(
method = "lm",
se = TRUE
) +
labs(
x = "Participant's mean RT for sentence 1",
y = "Lexical advantage (lexical accuracy − grammatical accuracy)"
) +
theme_bw()
lexical_advantage_plot
# exclude outlier
df_lexical_advantage_wider <- df_lexical_advantage_wider %>%
filter(participant != "5kqwq452")
lexical_advantage_plot <- ggplot(df_lexical_advantage_wider,
aes(x = mean_rt_sentence1, y = lexical_advantage)) +
geom_hline(yintercept = 0, linetype = "dashed", colour = "grey50") +
geom_point(size = 3) +
geom_smooth(
method = "lm",
se = TRUE
) +
labs(
x = "Participant's mean RT for sentence 1",
y = "Lexical advantage (lexical accuracy − grammatical accuracy)"
) +
theme_bw()
lexical_advantage_plot
View(df_accuracy_and_rt)
df_lex_advan_within_subj <- df_accuracy_and_rt %>%
group_by(participant, trial_index, affix_type) %>%
summarise(n = n())
View(df_lex_advan_within_subj)
df_lex_advan_within_subj <- df_accuracy_and_rt %>%
group_by(participant, sentence_id, affix_type) %>%
summarise(n = n())
View(df_lex_advan_within_subj)
df_lex_advan_within_subj <- df_accuracy_and_rt %>%
group_by(participant, sentence_id, affix_type, correct_incorrect, rt_per_char_z) %>%
summarise(n = n())
df_lex_advan_within_subj <- df_accuracy_and_rt %>%
group_by(participant, sentence_id, affix_type, rt_per_char_z) %>%
summarise(accuracy = first(correct_incorrect))
View(df_lex_advan_within_subj)
head(df_lex_advan_within_subj)
df_binned <- df_lex_advan_within_subj %>%
group_by(participant) %>%
mutate(
speed_bin = ntile(rt_per_char_z, 3),
speed_bin = factor(
speed_bin,
levels = 1:3,
labels = c("Fast", "Normal", "Slow")
)
) %>%
ungroup()
View(df_binned)
# calculate accuracy per condition and bin
df_accuracy <- df_binned %>%
group_by(participant, speed_bin, affix_type) %>%
summarise(
accuracy = mean(accuracy, na.rm = TRUE),
.groups = "drop"
)
View(df_accuracy)
# calculate lexical advantage
df_advantage <- df_accuracy %>%
tidyr::pivot_wider(
names_from = affix_type,
values_from = accuracy
) %>%
mutate(
lexical_advantage = lexical - grammatical
)
View(df_advantage)
# plot
ggplot(
df_advantage,
aes(x = speed_bin, y = lexical_advantage,
group = participant)
) +
geom_hline(
yintercept = 0,
linetype = "dashed",
color = "grey50"
) +
geom_line(
alpha = 0.25,
color = "grey50"
) +
geom_point(
alpha = 0.35,
size = 2
) +
stat_summary(
aes(group = 1),
fun = mean,
geom = "line",
linewidth = 1.3,
color = "black"
) +
stat_summary(
aes(group = 1),
fun = mean,
geom = "point",
size = 4,
color = "black"
) +
stat_summary(
aes(group = 1),
fun.data = mean_se,
geom = "errorbar",
width = 0.12,
linewidth = 0.8
) +
labs(
x = "Reading speed",
y = "Lexical advantage in accuracy",
title = "Lexical advantage depending on reading speed"
) +
theme_classic(base_size = 14)
