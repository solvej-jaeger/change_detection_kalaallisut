knitr::opts_chunk$set(echo = TRUE)
library(dplyr)
library(tidyr)
library(ggplot2)
library(ggpubr)
library(lme4)
library(lmerTest)
# reading data frame
data_frame <- read.csv("data/data_preprocessed/data.csv")
# removing rows we are not interested in
df_clean <- subset(data_frame, original_sentence != "")
# removing practice trials
df_clean <- subset(df_clean, !is.na(correct_change_answer))
demographics <- df_clean %>%
group_by(participant) %>%
summarise(language = first(language),
age = first(age),
education = first(education))
demographics
# excluding one participant who answered Danish as first language
# -------------------------------------------------------------
participant_to_exclude1 <- c("l4kkhlaf")
df_clean <- subset(df_clean, !participant %in% participant_to_exclude1)
data_frame <- subset(data_frame, !participant %in% participant_to_exclude1)
# making a "correct/incorrect"-column
df_clean$correct_incorrect <- ifelse(
df_clean$Ychange_Nchange_response == "no" & df_clean$correct_change_answer == "no_change" |
df_clean$Ychange_Nchange_response == "yes" & df_clean$correct_change_answer == "affix_deletion" & df_clean$response == df_clean$correct_response |
df_clean$Ychange_Nchange_response == "yes" & df_clean$correct_change_answer == "other_change" & df_clean$response == df_clean$correct_response |
df_clean$Ychange_Nchange_response == "yes" & df_clean$correct_change_answer == "subject_deletion"& df_clean$response == df_clean$correct_response,
1, 0)
# how many correct does each participant have?
df_correct_count <- df_clean %>%
group_by(participant) %>%
summarize(correct_count = sum(correct_incorrect))
# looking at the binomial distribution, we can see that the cutoff point must be 43 incorrect answers (p = 0.05).
# if participants have more than 43 incorrect answers (less than 53 correct), it is too probable that they have answered randomly
# note that this assumes equal 50% guessing probability per trial
dbinom(x=43,size=96,prob=0.5)
dbinom(x=44,size=96,prob=0.5)
# excluding participants that have less than 53 correct
participants_to_exclude2 <- subset(df_correct_count$participant, df_correct_count$correct_count < 53)
df_clean <- subset(df_clean, !participant %in% participants_to_exclude2)
data_frame <- subset(data_frame, !participant %in% participants_to_exclude2)
# checking how long they spent on the change detection part of the experiment
df_time_change_detection <- df_clean %>%
group_by(participant) %>%
summarise(total_time = max(time_elapsed, na.rm = TRUE)/60000)
df_time_change_detection
# excluding outliers whose total time spent on the change detection part was more than 3 SDs from the mean
mean_time <- mean(df_time_change_detection$total_time)
sd_time <- sd(df_time_change_detection$total_time)
cutoff <- mean_time + 3*sd_time
cutoff
participants_above_cutoff <- ("knkl4dbx")
df_clean <- subset(df_clean, !participant %in% participants_above_cutoff)
data_frame <- subset(data_frame, !participant %in% participants_above_cutoff)
reading_time_first_sentence <- data_frame %>%
group_by(participant, sentence_id_specific) %>%
summarise(reading_time_sentence1 = first(rt))
mean_reading_time_first_sentence <- reading_time_first_sentence %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA))) %>%
group_by(participant) %>%
summarise(mean_rt_sentence1 = mean(reading_time_sentence1))
change_detection_time <- data_frame %>%
group_by(participant, sentence_id_specific) %>%
summarise(change_detection_time = rt[[2]])
mean_change_detection_time <- change_detection_time %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA))) %>%
group_by(participant) %>%
summarise(mean_change_detection_rt = mean(change_detection_time))
localization_time <- data_frame %>%
group_by(participant, sentence_id_specific) %>%
summarise(localization_time = rt[[3]])
mean_localization_time <- localization_time %>%
filter(!(sentence_id_specific %in% c("p1", "p2", "p3", "p4", NA))) %>%
group_by(participant) %>%
summarise(mean_localization_rt = mean(localization_time))
rt_different_stages <- merge(merge(mean_reading_time_first_sentence, mean_change_detection_time), mean_localization_time)
rt_long <- rt_different_stages %>%
pivot_longer(
cols = c(
mean_rt_sentence1,
mean_change_detection_rt,
mean_localization_rt
),
names_to = "stage",
values_to = "rt"
)
rt_plot <- ggplot(rt_long, aes(x = "", y = rt)) +
geom_boxplot() +
facet_wrap(~ factor(stage, c("mean_rt_sentence1", "mean_change_detection_rt", "mean_localization_rt"))) +
ylim(c(0,11000)) +
labs(
x = NULL,
y = "Reaction time (ms)",
title = "Reaction times across stages"
) +
theme_bw()
rt_plot
ggsave("figures/rt_different_stages.png", plot = rt_plot, width = 9, height = 4)
View(reading_time_first_sentence)
View(reading_time_first_sentence)
View(data_frame)
View(data_frame)
reading_times_df <- data_frame %>%
group_by(participant, original_sentence, sentence_id_specific) %>%
summarise(reading_time_sentence1 = first(rt))
View(reading_times_df)
View(reading_time_first_sentence)
View(reading_times_df)
reading_times_df <- data_frame %>%
group_by(participant, sentence_id_specific) %>%
summarise(reading_time_sentence1 = first(rt),
sentence1 = nth(original_sentence, 3))
View(reading_times_df)
mutate(reading_time_per_character, rt_per_char = reading_time_first_sentence / nchar(sentence1))
reading_time_per_character <- data_frame %>%
group_by(participant, sentence_id_specific) %>%
summarise(reading_time_sentence1 = first(rt),
sentence1 = nth(original_sentence, 3))
mutate(reading_time_per_character, rt_per_char = reading_time_first_sentence / nchar(sentence1))
reading_time_per_character <- reading_time_per_character %>%
mutate(rt_per_char = reading_time_sentence1 / nchar(sentence1))
View(reading_time_per_character)
mean(reading_time_per_character$rt_per_char)
reading_time_per_character <- reading_time_per_character %>%
mutate(rt_per_char = reading_time_sentence1 / nchar(sentence1)) %>%
filter(sentence1 =! "")
reading_time_per_character <- reading_time_per_character %>%
mutate(rt_per_char = reading_time_sentence1 / nchar(sentence1)) %>%
filter(sentence1 != "")
mean(reading_time_per_character$rt_per_char)
knitr::opts_chunk$set(echo = TRUE)
library(ggplot2)
library(dplyr)
library(tidyr)
library(ggpubr)
library(lme4)
library(lmerTest)
data_frame <- read.csv("data.csv")
data_frame$correct_change_answer <- ifelse(data_frame$correct_change_answer == '', NA, data_frame$correct_change_answer)
data_frame <- data_frame %>%
fill(correct_change_answer,.direction = 'up')
df_clean <- subset(data_frame, correct_change_answer != "no_change_practice" & correct_change_answer != "change_practice")
df_clean$accuracy <- ifelse(df_clean$Ychange_Nchange_response == "no" & df_clean$correct_change_answer == "no_change" | df_clean$Ychange_Nchange_response == "yes" & df_clean$correct_change_answer == "deletion" | df_clean$Ychange_Nchange_response == "yes" & df_clean$correct_change_answer == "change", 1, 0)
df_clean$changed_verb <- case_when(
startsWith(df_clean$changed_word, 'all') ~ 'allappoq',
startsWith(df_clean$changed_word, 'ang') ~ 'angerlarpoq',
startsWith(df_clean$changed_word, 'ani') ~ 'anivoq',
startsWith(df_clean$changed_word, 'ane') ~ 'anivoq',
startsWith(df_clean$changed_word, 'ape') ~ 'aperivoq',
startsWith(df_clean$changed_word, 'bii') ~ 'biilerpoq',
startsWith(df_clean$changed_word, 'kaa') ~ 'kaagiliorpoq',
startsWith(df_clean$changed_word, 'nip') ~ 'nipangerpoq',
startsWith(df_clean$changed_word, 'pil') ~ 'pilerivoq',
startsWith(df_clean$changed_word, 'qas') ~ 'qasuvoq',
startsWith(df_clean$changed_word, 'qin') ~ 'qinerpoq',
startsWith(df_clean$changed_word, 'san') ~ 'sanerpoq',
startsWith(df_clean$changed_word, 'sul') ~ 'sulivoq',
startsWith(df_clean$changed_word, 'toq') ~ 'toqqorpoq',
startsWith(df_clean$changed_word, 'uni') ~ 'uninngavoq',
startsWith(df_clean$changed_word, 'aal') ~ 'aalisarpoq',
startsWith(df_clean$changed_word, 'aat') ~ 'aatsaarpoq',
TRUE ~ NA_character_  # Default case when no conditions match
)
df_clean_correct_count <- df_clean %>%
group_by(participant) %>%
summarize(accuracy = sum(accuracy))
hist(df_clean_correct_count$accuracy,
main="Histogram accuracy",
xlab="Number of correct responses (out of 80)",
ylab="Participants"
)
#df_clean_correct_count
dbinom(x=35,size=80,prob=0.5)
dbinom(x=36,size=80,prob=0.5)
df_clean$filler_condition <- ifelse(df_clean$filler_condition == '', NA, df_clean$filler_condition)
df_clean <- df_clean %>%
fill(filler_condition, .direction = 'up')
# checking accuracy in the filler condition
filler_accuracy <- df_clean %>%
filter(filler_condition == 'yes' &
phase=='change_blindness') %>%
group_by(changed_word) %>%
summarise(filler_accuracy = mean(accuracy), sd = sd (accuracy))
df_clean <- subset(df_clean, filler_condition != "yes")
# scaling accuracy according to each participant's mean and sd
# and adding this to a column named accuracy_scaled
#df_clean$accuracy_scaled <- as.numeric(scale(df_clean$accuracy))
# problem: doesn't work when a participant has all correct and sd is 0
model_affix_type <- glmer(accuracy ~ affix_type + (1|participant), family = 'binomial', df_clean %>% filter(phase =='change_blindness' & correct_change_answer == 'deletion'))
summary(model_affix_type)
df_clean$correct_change_answer <- as.factor(df_clean$correct_change_answer)
model_conditions <- glmer(accuracy ~ relevel(correct_change_answer, ref = 'deletion') + (1|participant), family = 'binomial', df_clean %>% filter(phase =='change_blindness' ))
summary(model_conditions)
model_affix_type_change <- glmer(accuracy ~ affix_type + (1|participant), family = 'binomial', df_clean %>% filter(phase =='change_blindness' & correct_change_answer == 'change'))
summary(model_affix_type_change)
df_demographics = df_clean %>%
distinct(participant, age, language, education)
df_demographics
# calculating each participant's mean and sd
df_grouped <- df_clean %>%
filter(phase == 'change_blindness') %>%
group_by(participant) %>%
summarise(mean_accuracy_participant = mean(accuracy), sd_accuracy = sd(accuracy))
# group the data by participant and affix type and calculate the mean accuracy
df_participant_mean <- df_clean %>%
filter(phase =='change_blindness') %>%
group_by(participant, affix_type) %>%
summarise(mean_accuracy = mean(accuracy))
# merge with df_grouped
df_participant_mean <- merge(df_participant_mean, df_grouped, by='participant')
# normalize mean accuracy based on participant mean and participant sd
df_participant_mean <- df_participant_mean %>%
mutate(normalized_accuracy = mean_accuracy - mean_accuracy_participant)
# create a bar plot with errorbars and jitter points
accuracy_barplot <- ggbarplot(df_participant_mean, x = "affix_type", y = "mean_accuracy",
add = c("mean_se", "jitter"),
xlab = FALSE, ylab = "accuracy",
title = "change detection of grammatical and lexical affixes")
accuracy_barplot
# create a similar bar plot but based on the normalized accuracy values
# accuracy_barplot_normalized <- ggbarplot(df_participant_mean, x = "affix_type", y = "normalized_accuracy",
#           add = c("mean_se", "jitter"),
#           xlab = FALSE, ylab = "accuracy",
#           title = "change detection of grammatical and lexical affixes")
# accuracy_barplot_normalized
# group the data by participant and calculate the accuracy
df_correct <- df_clean %>%
filter(phase =='change_blindness') %>%
group_by(participant, affix_type) %>%
summarise(
mean_accuracy = mean(accuracy)
)
# make a line plot
line_plot_correctness <- df_correct %>%
ggplot(aes(affix_type, mean_accuracy)) +
geom_line(data = df_correct, aes(affix_type, mean_accuracy, group = participant, color = participant), alpha = 0.4) +
stat_summary(fun = mean, geom = 'point', aes(group = 1)) +
stat_summary(fun = mean, geom = 'line', aes(group = 1), linewidth = 0.5) +
theme_bw() +
theme(legend.position = 'right', axis.text = element_text(size = 12), axis.title = element_text(size = 15)) +
labs(x = '', y = 'accuracy')
line_plot_correctness
