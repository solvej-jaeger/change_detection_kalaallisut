# deleting rows where correct_response is NA
df_response <- df_clean %>%
filter(!is.na(correct_response))
# make a column indicating whether they chose the correct word
df_response$response_word_accuracy <- ifelse(df_response$response == df_response$correct_response, 1, 0)
# checking how many chose the correct word after answering "yes" correctly
df_response_grouped <- df_response %>%
group_by(accuracy) %>%
summarize(accuracy_word = mean(response_word_accuracy))
df_response_grouped
df_rt <- df_clean[!is.na(df_clean$rt),]
# making a boxplot to see if any rt's stand out
ggplot(df_rt, aes(x=rt)) +
geom_boxplot()
# calculating the mean and standard deviation of the rt column
mean_value <- mean(df_rt$rt, na.rm=T)
std_dev <- sd(df_rt$rt, na.rm=T)
# set the threshold for outliers (3 standard deviations from the mean)
threshold <- 3 * std_dev
# remove rows where the values are more than 3 standard deviations from the mean
df_rt_cleaned <- df_rt[abs(df_rt$rt - mean_value) <= threshold, ]
# plotting cleaned df
ggplot(df_rt_cleaned, aes(x=rt)) +
geom_boxplot()
# converting empty strings to NA in specific columns
columns_to_convert <- c("filler_condition", "changed_word", "affix_type", "correct_change_answer", "target_word", "sentence_id", "target_syllables", "changed_verb", "target_affix")
data_frame_with_na <- df_rt_cleaned %>%
mutate(across(all_of(columns_to_convert), as.character)) %>%
mutate(across(all_of(columns_to_convert), ~na_if(.x, "")))
# filling filler_condition column
df_filled <- data_frame_with_na %>%
fill(filler_condition, .direction = "up")
# filling affix type column
df_filled <- df_filled %>%
fill(affix_type, .direction = "up")
# filling changed_word column
df_filled <- df_filled %>%
fill(changed_word, .direction = "up")
# filling target_word column
df_filled <- df_filled %>%
fill(target_word, .direction = "up")
# filling sentence_id column
df_filled <- df_filled %>%
fill(sentence_id, .direction = "up")
# filling target_syllables column
df_filled <- df_filled %>%
fill(target_syllables, .direction = "up")
# filling changed_verb column
df_filled <- df_filled %>%
fill(changed_verb, .direction = "up")
# filling target_affix column
df_filled <- df_filled %>%
fill(target_affix, .direction = "up")
df_filled <- df_filled %>%
mutate(current_word = gsub("\\.", "", current_word))
df_filled <- df_filled %>%
mutate(current_word = gsub("\\.", "", current_word))
